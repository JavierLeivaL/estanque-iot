# ---- Variables PÚBLICAS (cliente web). Se copian del bloque firebaseConfig de Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Variables SECRETAS (solo servidor / Vercel). Nunca subirlas a GitHub.
# Contenido COMPLETO del archivo .json de la cuenta de servicio de Firebase, en una sola variable.
FIREBASE_SERVICE_ACCOUNT=
# Clave para el endpoint de configuración inicial POST /api/v1/setup
SETUP_SECRET=
