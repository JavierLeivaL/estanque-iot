# Copiar a device/.env y completar. Este archivo NUNCA se sube a GitHub.
# URL pública de la plataforma en Vercel (sin / al final)
API_URL=https://estanque-iot.vercel.app
# Token del dispositivo, generado desde la plataforma web (Dispositivos > Generar token)
DEVICE_TOKEN=pegar-aqui-el-token
# Pines GPIO (numeración BCM) del HC-SR04
TRIG_GPIO=23
ECHO_GPIO=24
